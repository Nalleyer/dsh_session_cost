{
  "name": "dsh-session-cost",
  "version": "1.2.0",
  "description": "Per-session token cost in the DSH web footer: a clickable chip appended to the right of the official stats row (official peak/off-peak pricing, weekday-aware, with model-name routing; RMB/USD by UI locale) that expands into a detail panel with unit prices, the next peak switch, and per-model usage.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "billing",
    "token",
    "pricing",
    "session-cost",
    "cordis"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./pricing": "./lib/pricing.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nalleyer/dsh_session_cost.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/index.js && node --check lib/pricing.js && node --check lib/client.js",
    "prepublishOnly": "npm run check && npm test"
  },
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
